{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compilar Gerador",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-fdiagnostics-color=always",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/*.cpp",
                "-o", "${workspaceFolder}/output/Gerador.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compilador: C:/msys64/ucrt64/bin/g++.exe (MSYS2 GCC 15.2.0, C++17)"
        }
    ]
}